# Copy to .env and fill in. Never commit .env.
# Names only; values are placeholders until the code that reads them exists.

# Shared token required on every WebSocket connection, even on localhost (plan decision 22).
AGENTOPIA_TOKEN=

# Ports (localhost only)
AGENTOPIA_SIM_PORT=
AGENTOPIA_GATEWAY_PORT=

# Provider keys. Optional: leave empty to use each agent program's own login store.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
